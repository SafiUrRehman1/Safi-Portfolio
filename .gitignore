# WordPress core (installed via wp-cli / download, not version-controlled)
/wp-admin/
/wp-includes/
/wp-*.php
/xmlrpc.php
/license.txt
/readme.html
/index.php

# wp-content: ignore everything except our custom plugin/theme
/wp-content/*
!/wp-content/plugins
!/wp-content/themes
/wp-content/plugins/*
!/wp-content/plugins/portfolio-content
/wp-content/themes/*
!/wp-content/themes/portfolio-theme

# SQLite drop-in and database file are environment-specific
/wp-content/db.php
/wp-content/database/

# uploads, cache, upgrade artifacts
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/cache/

# Node
node_modules/

# OS
.DS_Store
